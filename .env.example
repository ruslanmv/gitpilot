# ============================================================================
# GitPilot — Environment Variables
# ============================================================================
# Copy to .env and fill in your values.
# Only the section for your chosen LLM provider is required.
# ============================================================================

# ── GitHub Authentication ──────────────────────────────────────────────────
# Option A: Personal Access Token (simplest)
GITHUB_TOKEN=ghp_your_token_here

# Option B: GitHub OAuth App (for multi-user)
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret

# Option C: GitHub App (for org installs)
# GITHUB_APP_ID=2313985
# GITHUB_APP_SLUG=gitpilota

# ── LLM Provider (pick ONE) ───────────────────────────────────────────────
# Set the active provider:
GITPILOT_PROVIDER=ollabridge
# Options: openai | claude | watsonx | ollama | ollabridge

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# GITPILOT_OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                          # leave empty for default

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# GITPILOT_CLAUDE_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=                       # leave empty for default

# --- IBM WatsonX ---
# WATSONX_API_KEY=...
# WATSONX_PROJECT_ID=...
# GITPILOT_WATSONX_MODEL=ibm/granite-3-8b-instruct
# WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://localhost:11434
# GITPILOT_OLLAMA_MODEL=llama3

# --- OllaBridge (managed Ollama) ---
OLLABRIDGE_BASE_URL=https://ruslanmv-ollabridge.hf.space
GITPILOT_OLLABRIDGE_MODEL=qwen2.5:1.5b
# OLLABRIDGE_API_KEY=                       # optional

# ── Lite Mode ──────────────────────────────────────────────────────────────
# Enable for small LLMs (< 7B). Uses simplified single-agent path.
# GITPILOT_LITE_MODE=true

# ── Resilience (production tuning) ─────────────────────────────────────────
# GITPILOT_AGENT_TIMEOUT=300                # max seconds per agent call (default 300)
# GITPILOT_CB_FAILURES=3                    # failures before circuit breaker opens
# GITPILOT_CB_RECOVERY=30                   # seconds before circuit breaker retries

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:5173
# GITPILOT_CONFIG_DIR=~/.gitpilot           # config/session storage dir

# ── Frontend (Vite / Vercel) ──────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8000

# ── HF Spaces (set automatically in Dockerfile) ───────────────────────────
# PORT=7860
# PYTHONUNBUFFERED=1
# GITPILOT_CONFIG_DIR=/tmp/gitpilot

# ── A2A / MCP (optional) ──────────────────────────────────────────────────
# GITPILOT_ENABLE_A2A=false
# GITPILOT_A2A_SHARED_SECRET=your_secret

# ── Langflow (optional) ───────────────────────────────────────────────────
# GITPILOT_LANGFLOW_URL=
# GITPILOT_LANGFLOW_API_KEY=
# GITPILOT_LANGFLOW_PLAN_FLOW_ID=
