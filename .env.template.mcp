# =============================================================================
# .env.template.mcp — copied to .mcp.env by `make install-mcp`
# -----------------------------------------------------------------------------
# Build-from-source strategy: we clone the four upstream MCP repos under
# ./mcp-stack/ and Compose builds each image from its Dockerfile. Refs
# below pin which branch / tag / SHA each clone uses; the install script
# is idempotent so re-running it cheaply updates each clone.
#
# Strictly additive: this file is loaded ONLY by docker-compose.mcp.yml
# when the `mcp` profile is active. Default `docker compose up` ignores
# it. Never commit .mcp.env (it contains secrets); .gitignore is set up
# for you.
# =============================================================================

# ---- Required ---------------------------------------------------------------
# Bearer token shared between MCP Context Forge and any client (GitPilot,
# HomePilot, custom CLIs). Rotate by editing this file and `make stop-mcp`
# / `make run-mcp`. The token never leaves your machine.
MCP_AUTH_TOKEN=change-me-please-32-bytes-of-randomness

# ---- Upstream repo URLs (override only if you fork) -------------------------
MCP_FORGE_REPO=https://github.com/ruslanmv/mcp-context-forge.git
MCP_POSTGRE_REPO=https://github.com/ruslanmv/mcp-postgre-server.git
MCP_MILVUS_REPO=https://github.com/ruslanmv/milvus-admin-ui.git
MCP_INSPECTOR_REPO=https://github.com/ruslanmv/mcp-inspector-server.git

# ---- Pinned refs (branch / tag / SHA) ---------------------------------------
# Default: the integration branch where GitPilot's MCP work lives.
# Once these changes merge to each upstream's main/master, switch each
# REF below to "main" or a release tag for reproducible builds.
MCP_FORGE_REF=claude/add-mcp-context-tools-xt3It
MCP_POSTGRE_REF=claude/add-mcp-context-tools-xt3It
MCP_MILVUS_REF=claude/add-mcp-context-tools-xt3It
MCP_INSPECTOR_REF=claude/add-mcp-context-tools-xt3It

# ---- Ports (override if collisions) -----------------------------------------
MCP_FORGE_PORT=4444
MCP_POSTGRE_PORT=8080
MCP_MILVUS_PORT=8082
MCP_INSPECTOR_PORT=8081

# ---- Per-server tokens (defaults to MCP_AUTH_TOKEN if blank) ----------------
MCP_POSTGRE_TOKEN=
MCP_MILVUS_TOKEN=
MCP_INSPECTOR_TOKEN=

# ---- Logging ----------------------------------------------------------------
MCP_FORGE_LOG_LEVEL=INFO
