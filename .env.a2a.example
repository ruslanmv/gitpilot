# GitPilot A2A (ContextForge-compatible) example env
# Copy to .env.a2a and fill values

# Enable A2A adapter endpoints
GITPILOT_ENABLE_A2A=true

# Require a shared secret for A2A requests (recommended)
GITPILOT_A2A_REQUIRE_AUTH=true
GITPILOT_A2A_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Max request body size in MB (protects from abuse)
GITPILOT_A2A_MAX_BODY_MB=2

# Security: keep false to avoid tokens in request bodies/logs
GITPILOT_A2A_ALLOW_GITHUB_TOKEN_IN_PARAMS=false
