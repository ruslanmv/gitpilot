{
  "name": "gitpilot-vscode",
  "displayName": "GitPilot — Multi-Agent AI Coding Assistant",
  "description": "The first multi-agent AI pair programmer for VS Code. Ten specialized agents — Explorer, Planner, Coder, Reviewer and more — collaborate on every task, and you approve every change. Works with OllaBridge, Ollama, Open WebUI, OpenAI, Claude, watsonx, or any OpenAI-compatible endpoint.",
  "version": "0.2.8",
  "preview": false,
  "publisher": "ruslanmv",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruslanmv/gitpilot"
  },
  "homepage": "https://github.com/ruslanmv/gitpilot#readme",
  "bugs": {
    "url": "https://github.com/ruslanmv/gitpilot/issues"
  },
  "galleryBanner": {
    "color": "#1C1C1F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Testing",
    "Linters",
    "Data Science"
  ],
  "keywords": [
    "ai",
    "ai-coding",
    "copilot",
    "pair-programming",
    "code-review",
    "code-generation",
    "refactoring",
    "openai",
    "claude",
    "ollama",
    "watsonx",
    "github",
    "agent",
    "multi-agent",
    "security",
    "testing"
  ],
  "activationEvents": [
    "onCommand:gitpilot.diagnostics",
    "onCommand:gitpilot.explainSelection",
    "onCommand:gitpilot.explain_project",
    "onCommand:gitpilot.fixSelection",
    "onCommand:gitpilot.fix_selection",
    "onCommand:gitpilot.generate_tests",
    "onCommand:gitpilot.newSession",
    "onCommand:gitpilot.openChat",
    "onCommand:gitpilot.openChatTab",
    "onCommand:gitpilot.openHome",
    "onCommand:gitpilot.openSettings",
    "onCommand:gitpilot.refreshProjectContext",
    "onCommand:gitpilot.refreshSessions",
    "onCommand:gitpilot.refreshSkills",
    "onCommand:gitpilot.refreshStatus",
    "onCommand:gitpilot.rewind",
    "onCommand:gitpilot.revertProposedChanges",
    "onCommand:gitpilot.reviewFile",
    "onCommand:gitpilot.reviewSelection",
    "onCommand:gitpilot.review_file",
    "onCommand:gitpilot.scanFile",
    "onCommand:gitpilot.scanWorkspace",
    "onCommand:gitpilot.security_scan",
    "onCommand:gitpilot.selectModel",
    "onCommand:gitpilot.selectModelV2",
    "onCommand:gitpilot.selectProvider",
    "onCommand:gitpilot.selectProviderV2",
    "onCommand:gitpilot.sendMessage",
    "onCommand:gitpilot.setupWizard",
    "onCommand:gitpilot.showAgentFlow",
    "onCommand:gitpilot.showServerInfo",
    "onCommand:gitpilot.testSelection",
    "onStartupFinished",
    "onView:gitpilot.navView"
  ],
  "main": "./out/extension.js",
