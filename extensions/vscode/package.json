    "keybindings": [
      {
        "command": "gitpilot.openChat",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "gitpilot.sendMessage",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "gitpilot.chatFocused"
      },
      {
        "command": "gitpilot.scanFile",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorFocus"
      }
    ],
    "configuration": {
      "title": "GitPilot",
      "properties": {
        "gitpilot.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the GitPilot API server",
          "order": 1
        },
        "gitpilot.serverCommand": {
          "type": "string",
          "default": "gitpilot",
          "description": "Command used to start the local GitPilot server from the Settings page. Use a full path if 'gitpilot' is not on your PATH.",
          "order": 2
        },
        "gitpilot.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to GitPilot server on startup",
          "order": 2
        },
        "gitpilot.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub personal access token (falls back to GITPILOT_GITHUB_TOKEN or GITHUB_TOKEN env vars)",
          "order": 3
        },
        "gitpilot.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens hints (Explain/Review) above functions and classes",
          "order": 4
        },
        "gitpilot.showHomeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open GitPilot Home in the editor when a window starts with no files open. Home is never opened on top of work already in progress.",
          "order": 5
        },
        "gitpilot.permissionMode": {
          "type": "string",
          "enum": [
            "normal",
            "plan",
            "auto"
          ],
          "default": "normal",
          "enumDescriptions": [
            "Ask before risky operations (recommended)",
            "Read-only mode — all writes blocked",
            "Allow all operations without confirmation"
          ],
          "description": "Agent permission mode",
          "order": 5
        },
        "gitpilot.defaultTopology": {
          "type": "string",
          "default": "default",
          "description": "Default agent topology to use",
          "order": 6
        },
        "gitpilot.showSecurityDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show security scan findings in the Problems panel",
          "order": 7
        },
        "gitpilot.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run security scan when saving files",
          "order": 8
        },
        "gitpilot.chatFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 10,
          "maximum": 24,
          "description": "Font size for the chat panel",
          "order": 9
        },
        "gitpilot.maxChatHistory": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum number of chat messages to keep in memory",
          "order": 10
        },
        "gitpilot.liteMode": {
          "type": "boolean",
          "default": false,
          "description": "Lite Mode: optimized for small LLMs (< 7B params). Uses simplified prompts and single-agent execution instead of multi-agent pipelines. Recommended for qwen2.5:1.5b, phi-3-mini, gemma-2b, tinyllama.",
          "order": 11
        },
        "gitpilot.llmTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "description": "How long to wait for a chat, plan or execute request before giving up. These run a model, so they are slow by nature — a local Ollama answering with repository context routinely takes 20-60s. Raise this if a large model on CPU is being cut off; the request is never retried, so a timeout here means the answer is lost, not duplicated.",
          "order": 12
        },
        "gitpilot.mcp.gatewayUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL of the MCP Context Forge gateway whose servers become tools for your coding agents. Leave empty to use the GitPilot server's own setting (or `GITPILOT_MCP_FORGE_URL`). Run **GitPilot: Configure MCP Gateway** for a guided setup that also tests the connection.",
          "order": 20
        },
        "gitpilot.mcp.authMode": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "token",
            "login"
          ],
          "enumDescriptions": [
            "Detect what the gateway accepts (recommended)",
            "Send no credential — for a gateway with authentication disabled",
            "Send a Forge API token",
            "Sign in with an admin email and password"
          ],
          "default": "auto",
          "description": "How GitPilot authenticates with the MCP Context Forge gateway.",
          "order": 21
        },
        "gitpilot.mcp.adminEmail": {
          "type": "string",
          "default": "",
          "description": "Admin email used to sign in to the MCP gateway. The password is NOT a setting: run 'GitPilot: Configure MCP Gateway' to enter it — it is stored by the GitPilot server, never in VS Code.",
          "order": 22
        },
        "gitpilot.mcp.forgePort": {
          "type": "number",
          "default": 4444,
          "description": "Port MCP Context Forge listens on when GitPilot starts it for you.",
          "order": 23
        },
        "gitpilot.mcp.forgeImage": {
          "type": "string",
          "default": "ghcr.io/ibm/mcp-context-forge:latest",
          "description": "Container image used to start MCP Context Forge when the workspace has no docker-compose.mcp.yml. Point this at an image your network can reach if the default is unavailable.",
          "order": 24
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "gitpilot.explainSelection",
          "when": "editorHasSelection",
          "group": "gitpilot@1"
        },
        {
          "command": "gitpilot.reviewSelection",
          "when": "editorHasSelection",
          "group": "gitpilot@2"
        },
        {
          "command": "gitpilot.fixSelection",
          "when": "editorHasSelection",
          "group": "gitpilot@3"
        },
        {
          "command": "gitpilot.reviewFile",
          "group": "gitpilot@4"
        },
        {
          "command": "gitpilot.scanFile",
          "group": "gitpilot@5"
        }
      ],
      "editor/title": [
        {
          "command": "gitpilot.reviewFile",
          "when": "editorFocus",
          "group": "navigation"
        },
        {
          "command": "gitpilot.scanFile",
          "when": "editorFocus",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "gitpilot.openHome",
          "when": "view == gitpilot.navView",
          "group": "navigation"
        },
        {
          "command": "gitpilot.newSession",
          "when": "view == gitpilot.sessionsView",
          "group": "navigation"
        },
        {
          "command": "gitpilot.refreshSessions",
          "when": "view == gitpilot.sessionsView",
          "group": "navigation"
        },
        {
          "command": "gitpilot.refreshSkills",
          "when": "view == gitpilot.skillsView",
          "group": "navigation"
        },
        {
          "command": "gitpilot.installPlugin",
          "when": "view == gitpilot.skillsView",
          "group": "navigation"
        },
        {
          "command": "gitpilot.setupWizard",
          "when": "view == gitpilot.navView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitpilot.deleteSession",
          "when": "viewItem == session",
          "group": "inline"
        },
        {
          "command": "gitpilot.uninstallPlugin",
          "when": "viewItem == plugin",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "gitpilot.explainSymbol",
          "when": "false"
        },
        {
          "command": "gitpilot.reviewSymbol",
          "when": "false"
        },
        {
          "command": "gitpilot.loadSession",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "gitpilot.gettingStarted",
        "title": "Get Started with GitPilot",
        "description": "Set up GitPilot's multi-agent AI coding assistant in VS Code",
        "steps": [
          {
            "id": "startServer",
            "title": "Start the GitPilot Server",
            "description": "Install the GitPilot backend (PyPI: `gitcopilot`) and start the API server. Requires Python 3.11 or 3.12.\n\n```bash\npip install 'gitcopilot>=0.2.6'\ngitpilot serve\n```\n\nThe package on PyPI is **gitcopilot**; the command is **gitpilot**.\n\n[Open Terminal](command:workbench.action.terminal.new)",
            "media": {
              "markdown": ""
            }
          },
          {
            "id": "connectServer",
            "title": "Connect to Server",
            "description": "Configure the server URL (default: http://127.0.0.1:8000).\n[Set Server URL](command:gitpilot.setServer)",
            "media": {
              "markdown": ""
            }
          },
          {
            "id": "setupWizard",
            "title": "Run the Setup Wizard",
            "description": "Let GitPilot detect your workspace, Git repository, provider, and model.\n[Run Setup Wizard](command:gitpilot.setupWizard)",
            "media": {
              "markdown": ""
            }
          },
          {
            "id": "openChat",
            "title": "Open Chat Panel",
            "description": "Start chatting with GitPilot using the sidebar or keyboard shortcut.\n[Open Chat (Ctrl+Shift+G)](command:gitpilot.openChat)",
            "media": {
