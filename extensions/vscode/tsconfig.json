{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "rootDir": "src",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "types": ["node", "vscode"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "out",
    ".vscode-test",
    "**/* copy*.ts",
    "**/* copy*.tsx",
    "**/*.copy.ts",
    "**/*.backup.ts",
    "**/*.bak.ts"
  ]
}