# Combined stack env (GitPilot + MCP ContextForge)
# Copy to .env.stack and fill values.
#
# GitPilot
GITPILOT_PUBLIC_BASE_URL=http://localhost:8000
GITPILOT_ENABLE_A2A=true
GITPILOT_A2A_REQUIRE_AUTH=true
GITPILOT_A2A_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
GITPILOT_A2A_MAX_BODY_MB=2
GITPILOT_A2A_ALLOW_GITHUB_TOKEN_IN_PARAMS=false

# (Optional) GitPilot auth/LLM settings - keep your existing .env usage
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# etc.

# ContextForge / MCP Gateway
# These values are read by ContextForge's docker-compose (see mcp-context-forge/.env.example)
# Set a strong value for JWT secret in prod.
MCPGATEWAY_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
